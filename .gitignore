# Local automated tests and fixtures are not published with application code.
/tests/*
!/tests/Feature/
/tests/Feature/*
!/tests/Feature/SellerDashboardPerformanceTest.php
!/tests/Feature/PortalSessionIsolationTest.php
!/tests/Concerns/
!/tests/Concerns/InteractsWithPortalSessions.php
/.phpunit.result.cache
/.phpunit.cache/
/coverage/
/phpunit.xml
/phpunit.xml.*

# Local server configuration and secrets.
/nginx.htaccess
/.env
/.env.*
!/.env.example
/auth.json

# Installed dependencies and local tooling.
/vendor/
/node_modules/
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Laravel runtime files; retain directory placeholders.
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/debugbar/
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/*.key
/public/storage
/public/hot

# User uploads and collected media; preserve the import template.
/public/uploads/
/public/download/*
!/public/download/product_bulk_demo.xlsx
/app/Http/Controllers/apicj_input*.txt
/app/Http/Controllers/tog_input*.txt

# Local backups and temporary reports.
/backups/
/backup/
/tmp/
/temp/
*.bak
*.orig
*.rej
*.log
*.sql.gz
*.sql.zip
